# Every setting is optional; see src/livefeed/config.py for all of them.
LIVEFEED_DATABASE_URL=postgresql://livefeed:livefeed@localhost:5432/livefeed
LIVEFEED_REDIS_URL=redis://localhost:6379/0
LIVEFEED_CLIENT_QUEUE_MAX=2000
LIVEFEED_MAX_REPLAY=10000
LIVEFEED_HEARTBEAT_INTERVAL_S=15
LIVEFEED_RESYNC_INTERVAL_S=1
LIVEFEED_LOG_LEVEL=INFO
